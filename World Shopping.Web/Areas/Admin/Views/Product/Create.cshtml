@model ProductVM

@{
    ViewBag.PageTitle = "Product Management";
    ViewBag.CardTitle = "Create Product";
    Layout = "~/Views/Shared/_dashboard.cshtml";
}


<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" method="post" enctype="multipart/form-data" name="form">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Product.Name"></label>
                <input asp-for="Product.Name" class="form-control" />
                <span asp-validation-for="Product.Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Product.Description"></label>
                <textarea id="mytextarea" asp-for="Product.Description" class="form-control"></textarea>
                <span asp-validation-for="Product.Description" class="text-danger"></span>

            </div>
            <div class="form-group">
                <label asp-for="Product.Price"></label>
                <input asp-for="Product.Price" class="form-control" />
                <span asp-validation-for="Product.Price" class="text-danger"></span>

            </div>
            <div class="form-group">
                <label asp-for="Product.Image"></label>
                <input type="file" name="file" id="imgfile" class="form-control" onchange="fillimg(event);" />

            </div>
            <div class="form-group">
                <label asp-for="Product.CategoryId"></label>
                <select asp-for="Product.CategoryId" class="form-control" asp-items="ViewBag.CategoryList">
                    <option disabled selected >-- Select Categort --</option>
                </select>

            </div>
            <div class="form-group">
                <button type="submit" class="btn btn-primary">Create</button>
                <a asp-action="Index" asp-controller="Category" class="btn btn-warning">Back To Index</a>
            </div>
        </form>
    </div>
    <div class="form-group col-md-4">
        <div class="container">
            <img id="ImagePrevew" width="300" height="300" />
        </div>
    </div>

</div>



@section Scripts{
    <partial name="_ValidationScriptsPartial" />

    <script>
        var fillimg = function(event){
            var imgholder = document.getElementById("ImagePrevew");
            imgholder.src = URL.createObjectURL(event.target.files[0]);
        }
    </script>

    <script>
        $(document).ready(function() {
            $('#mytextarea').summernote({
              height: 300
            });
          });
    </script> 
} 
