@model Category

@{
    ViewBag.PageTitle = "Category Management";
    ViewBag.CardTitle = "Create Category";
    Layout = "~/Views/Shared/_dashboard.cshtml";
}


<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" method="post">
            <div class="form-group">
                <label asp-for="Name"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description"></label>
                <textarea id="mytextarea" asp-for="Description" class="form-control"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>

            </div>
            <div class="form-group">
                <button type="submit" class="btn btn-primary">Create</button>
                <a asp-action="Index" asp-controller="Category" class="btn btn-warning">Back To Index</a>
            </div>
        </form>
    </div>
</div>

@*Data Validation Client Side*@
 @section Scripts{
    <partial name="_ValidationScriptsPartial" />



    <script>
        $(document).ready(function() {
            $('#mytextarea').summernote({
              height: 300
                });
                  });
    </script>

}