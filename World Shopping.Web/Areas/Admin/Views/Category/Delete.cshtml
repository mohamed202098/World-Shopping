@model Category

@{
    ViewBag.PageTitle = "Category Management";
    ViewBag.CardTitle = "Delete Category";
    Layout = "~/Views/Shared/_dashboard.cshtml";
}


<div class="row">
    <div class="col-md-4">
        <form asp-action="DeleteCategory" method="post">
            <input hidden asp-for="Id" />
            <div class="form-group">
                <label asp-for="Name"></label>
                <input asp-for="Name" disabled class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description"></label>
                <textarea asp-for="Description" disabled class="form-control"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>

            </div>
            <br />
            <div class="form-group">
                <input type="submit" value="Delete" class="btn btn-danger" />
                <a asp-action="Index" asp-controller="Category" class="btn btn-warning">Back To Index</a>
            </div>
        </form>
    </div>
</div>


@*Data Validation Client Side*@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />


}
