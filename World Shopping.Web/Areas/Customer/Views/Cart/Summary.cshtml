@model ShoppingCartVM
@using Microsoft.Extensions.Options
@inject IOptions<World_Shopping.Utilities.StripeData> Stripe


<!doctype html>

<html>
    <head>
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.3.1/css/bootstrap.min.css">
        <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.2.1/jquery.min.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.12.9/umd/popper.min.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.3.1/js/bootstrap.min.js"></script>
        <link href="~/css/summary.css" rel="stylesheet" />
    </head>

    <body className='snippet-body'>

       <div class="wrapper">
         <div class="h5 large">Billing Address</div>
           <form method="post">
               <div class="row">
                   <div class="col-lg-6 col-md-8 col-sm-10 offset-lg-0 offset-md-2 offset-sm-1">
                      <div class="mobile h5">Billing Address</div>
                      <div id="details" class="bg-white rounded pb-5">

                        <div class="form-group">
                            <label class="text-muted">Name</label>
                            <input asp-for="OrderHeader.Name" type="text" class="form-control">
                            <span asp-validation-for="OrderHeader.Name"></span>
                        </div>

                        <div class="row">
                            <div class="col-lg-6">
                                <div class="form-group">
                                    <label>City</label>
                                    <div class="d-flex jusify-content-start align-items-center rounded p-2">
                                        <input asp-for="OrderHeader.City" type="text">
                                        <span class="fas fa-check text-success pr-2"></span>
                                        <span asp-validation-for="OrderHeader.City"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-6">
                                <div class="form-group">
                                    <label>Phone Number</label>
                                    <div class="d-flex jusify-content-start align-items-center rounded p-2">
                                        <input asp-for="@Model.OrderHeader.Phone" type="text">
                                        <span class="fas fa-check text-success pr-2"></span>
                                        <span asp-validation-for="@Model.OrderHeader.Phone"></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-lg-12">
                                <div class="form-group">
                                    <label>Address</label>
                                    <div class="d-flex jusify-content-start align-items-center rounded p-2">
                                        <input asp-for="OrderHeader.Address" type="text">
                                        <span class="fas fa-check text-success pr-2"></span>
                                        <span asp-validation-for="OrderHeader.Address"></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                   </div>
               </div>

               <div class="col-lg-6 col-md-8 col-sm-10 offset-lg-0 offset-md-2 offset-sm-1 pt-lg-0 pt-3">
                   <div id="cart" class="bg-white rounded">

                        <div class="d-flex justify-content-between align-items-center">
                            <div class="h6">Cart Summary</div>
                            <div class="h6">
                                <a href="#">Edit</a>
                            </div>
                        </div>

                        @foreach (var item in Model.CartsList)
                        {
                            <div class="d-flex jusitfy-content-between align-items-center pt-3 pb-2 border-bottom">

                                <div class="item pr-2">
                                    <img src="@ViewBag.ImagePath@item.Product.Image"
                                         alt="" width="80" height="80">
                                    <div class="number">@item.Count</div>
                                </div>

                                <div class="d-flex flex-column px-3">
                                    <b class="h5">@item.Product.Name</b>
                                </div>

                                <div class="ml-auto">
                                    <b class="h5">$@item.Product.Price</b>
                                </div>
                            </div>
                        }

                        <div class="d-flex align-items-center py-2">
                            <div class="display-5">Total</div>
                            <div class="ml-auto d-flex">

                                <div class="text-primary text-uppercase px-3">usd</div>
                                <div class="font-weight-bold">$@Model.OrderHeader.TotalPrice</div>

                            </div>
                        </div>

                        <div class="row pt-lg-3 pt-2 buttons mb-sm-0 mb-2">
                           <div class="col-md-6">
                           <div class="btn text-uppercase">
                             <a href="/Customer/Home">back to shopping</a>
                           </div>
                        </div> 
                         
                        <div class="col-md-6 pt-md-0 pt-1" style="padding-inline: 0px;">
                            <button type="submit" class="btn btn-primary">Place Order</button>
                        </div>

                        <div class="text-muted pt-3" id="mobile">
                            <span class="fas fa-lock"></span>
                            Your information is save
                        </div>
           
                   </div>
               </div>
           </form>

           <div class="text-muted">
              <span class="fas fa-lock"></span>
              Your information is save
           </div>
       </div>

    </body>
</html>









































